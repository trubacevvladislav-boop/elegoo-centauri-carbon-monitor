# IP-адрес вашего принтера в локальной сети / Your printer's local IP address
PRINTER_IP=192.168.0.234

# Токен Telegram бота (получите у @BotFather) / Telegram bot token (get from @BotFather)
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID для отправки уведомлений / Chat ID for notifications
TG_CHAT_ID=123456789

# URL прокси для Telegram (опционально) / Proxy URL for Telegram (optional)
# Раскомментируйте и заполните, если Telegram заблокирован / Uncomment if Telegram is blocked
# Примеры / Examples: http://127.0.0.1:8080 или / or socks5://127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:8080

# Язык интерфейса / Interface language
# ru - Русский / Russian
# en - English
LANGUAGE=ru
