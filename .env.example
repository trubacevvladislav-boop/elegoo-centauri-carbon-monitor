# IP-адрес вашего принтера в локальной сети
PRINTER_IP=192.168.0.234

# Токен Telegram бота (получите у @BotFather)
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID для отправки уведомлений
TG_CHAT_ID=123456789

# URL прокси для Telegram (опционально)
# Раскомментируйте и заполните, если Telegram заблокирован в вашем регионе
# Примеры: http://127.0.0.1:8080 или socks5://127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:8080
